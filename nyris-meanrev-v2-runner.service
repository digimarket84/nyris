[Unit]
Description=Nyris - runner MEAN-REVERSION v2 daily (univers elargi top-100 USDT, oneshot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/nyris/app
EnvironmentFile=/srv/nyris/config/.env
ExecStart=/srv/nyris/.venv/bin/python -m nyris.strategy.meanrev_v2_runner
SyslogIdentifier=nyris-meanrev-v2-runner
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
