[Unit]
Description=Nyris API (FastAPI / Uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target
# Anti crash-loop : pas plus de 5 redemarrages / 60s
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/nyris/app
EnvironmentFile=/srv/nyris/config/.env
ExecStart=/srv/nyris/.venv/bin/uvicorn nyris.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
SyslogIdentifier=nyris
StandardOutput=journal
StandardError=journal

# Durcissement leger (compatible avec le layout /srv, aucune ecriture disque requise)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
